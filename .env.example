# OpenMontage - Environment Variables
# 将本文件复制为 .env 并填入你的密钥
# Copy this to .env and fill in your keys

# --- Image + video gateway ---
# FLUX images, Google Veo video, Kling video, MiniMax video, Recraft images.
# Get one at https://fal.ai/dashboard/keys
# 图像 + 视频网关：FLUX 图像、Google Veo 视频、Kling 视频、MiniMax 视频、Recraft 图像。
# 在 https://fal.ai/dashboard/keys 获取
FAL_KEY=
# Alias for FAL_KEY (some SDKs/docs use this name); either one is read.
# FAL_KEY 的别名（部分 SDK/文档使用此名称）；两者任填其一即可。
FAL_AI_API_KEY=

# --- MiniMax official direct API ---
# First-party image generation plus MiniMax H3 / older Hailuo video generation.
# Get one at https://platform.minimax.io/user-center/basic-information/interface-key
# MiniMax 官方直连 API：官方图像生成以及 MiniMax H3 / 旧版 Hailuo 视频生成。
# 在 https://platform.minimax.io/user-center/basic-information/interface-key 获取
MINIMAX_API_KEY=
# Optional: global (default) or cn.
# 可选：global（默认）或 cn。
MINIMAX_REGION=global
# Optional endpoint override; normally leave blank so MINIMAX_REGION selects it.
# 可选的端点覆盖；一般留空，由 MINIMAX_REGION 自动选择。
# MINIMAX_BASE_URL=

# --- Replicate ---
# Replicate-hosted video gen (seedance_replicate). Needed to make the
# Replicate-backed Seedance path selectable alongside the fal.ai one.
# Get one at https://replicate.com/account/api-tokens
# Replicate：Replicate 托管的视频生成（seedance_replicate）。启用它与 fal.ai 路径
# 并列的 Replicate 版 Seedance 通道时需要。
# 在 https://replicate.com/account/api-tokens 获取
REPLICATE_API_TOKEN=

# --- Higgsfield ---
# Higgsfield Cloud key (higgsfield_video). Pair with the secret below,
# or use the combined HIGGSFIELD_KEY="<key>:<secret>" form instead.
# Higgsfield：Higgsfield Cloud 密钥（higgsfield_video）。与下方的 secret 配对使用，
# 或改用合并形式 HIGGSFIELD_KEY="<key>:<secret>"。
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HIGGSFIELD_KEY=            # Combined key:secret — set this INSTEAD of the _KEY/_SECRET pair if you prefer.
# 合并的 key:secret 形式 —— 若偏好此形式，用它代替上面的 _KEY/_SECRET 组合。

# --- Kling official direct API ---
# Official Kling API key; enables video, image, TTS, avatar, lip sync.
# Kling 官方直连 API：Kling 官方 API 密钥；启用视频、图像、TTS、数字人、对口型。
KLING_API_KEY=
# Optional endpoint override; leave blank for default https://api-singapore.klingai.com
# Mainland China accounts can use https://api-beijing.klingai.com
# 可选的端点覆盖；留空则使用默认 https://api-singapore.klingai.com
# 中国大陆账号可使用 https://api-beijing.klingai.com
KLING_API_BASE_URL=

# --- Google (one key unlocks image gen + TTS + video) ---
# Google Imagen images, Google Cloud TTS (700+ voices, 50+ languages),
# Gemini Omni video (generation + conversational editing, paid tier).
# Get one at https://aistudio.google.com/apikey
# Google（一个密钥解锁图像生成 + TTS + 视频）：Google Imagen 图像、
# Google Cloud TTS（700+ 音色、50+ 语言）、Gemini Omni 视频（生成 + 对话式编辑，付费档）。
# 在 https://aistudio.google.com/apikey 获取
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # Alias for GOOGLE_API_KEY (takes precedence when both are set)
# GEMINI_API_KEY 是 GOOGLE_API_KEY 的别名（两者同时设置时优先生效）
# Alternative to the API key: service-account JSON auth.
# TTS uses Cloud Text-to-Speech; Imagen routes to Vertex AI.
# API key 的替代方案：服务账号 JSON 认证。
# TTS 使用 Cloud Text-to-Speech；Imagen 走 Vertex AI。
# Path to a service-account JSON key file.
# 服务账号 JSON 密钥文件路径。
GOOGLE_APPLICATION_CREDENTIALS=
# GCP project id (required for Imagen via Vertex AI).
# GCP 项目 id（通过 Vertex AI 使用 Imagen 时必填）。
GOOGLE_CLOUD_PROJECT=
# Vertex AI region, default us-central1.
# Vertex AI 区域，默认 us-central1。
GOOGLE_CLOUD_LOCATION=

# --- Voice ---
# TTS narration, music generation, sound effects.
# 语音：TTS 配音、音乐生成、音效。
ELEVENLABS_API_KEY=
# OpenAI TTS fallback and GPT Image 2 image generation.
# OpenAI TTS 备用通道及 GPT Image 2 图像生成。
OPENAI_API_KEY=
# Grok image generation/editing and Grok video generation.
# Grok 图像生成/编辑及 Grok 视频生成。
XAI_API_KEY=
# Volcengine Doubao Speech TTS (new console API Key).
# 火山引擎豆包语音 TTS（新版控制台 API Key）。
DOUBAO_SPEECH_API_KEY=
# Default Doubao speaker/voice type, e.g. zh_female_vv_uranus_bigtts.
# 默认豆包说话人/音色，例如 zh_female_vv_uranus_bigtts。
DOUBAO_SPEECH_VOICE_TYPE=
# fish.audio TTS (s1 / s2-pro / s2.1-pro, reference_id voice cloning).
# fish.audio TTS（s1 / s2-pro / s2.1-pro，reference_id 音色克隆）。
FISH_AUDIO_API_KEY=
# Piper local voices do not require env vars; install `piper-tts` via pip
# Piper 本地音色无需环境变量；通过 pip 安装 `piper-tts` 即可

# --- DashScope (Alibaba Cloud Bailian) ---
# Qwen image gen (qwen-image-2.0-pro), TTS (qwen3-tts-flash), ASR with word timestamps (qwen3-asr-flash-filetrans).
# Get one at https://dashscope.aliyun.com/
# DashScope（阿里云百炼）：Qwen 图像生成（qwen-image-2.0-pro）、TTS（qwen3-tts-flash）、
# 带词级时间戳的 ASR（qwen3-asr-flash-filetrans）。
# 在 https://dashscope.aliyun.com/ 获取
DASHSCOPE_API_KEY=

# --- Tencent Hunyuan TokenHub API ---
# Tencent Hunyuan (腾讯混元) image and cloud video generation via TokenHub
# (Bearer token).
# Get it at https://console.cloud.tencent.com/tokenhub.
# 腾讯混元 TokenHub API：通过 TokenHub（Bearer token）使用腾讯混元图像与云端视频生成。
# 在 https://console.cloud.tencent.com/tokenhub 获取。
TENCENT_TOKENHUB_API_KEY=

# --- Music ---
# Suno AI music generation (full songs, instrumentals, any genre).
# 音乐：Suno AI 音乐生成（完整歌曲、纯音乐、任意曲风）。
SUNO_API_KEY=

# --- Video Generation ---
# Volcengine Ark direct Seedance 2.0 / 2.5 API key body (without the "Bearer " prefix).
# Get one at https://console.volcengine.com/ark/region:cn-beijing/apiKey
# 视频生成：火山方舟直连 Seedance 2.0 / 2.5 API 密钥本体（不含 "Bearer " 前缀）。
# 在 https://console.volcengine.com/ark/region:cn-beijing/apiKey 获取
ARK_API_KEY=
# Optional overrides; uncomment only when needed.
# 可选覆盖项；仅在需要时取消注释。
# ARK_SEEDANCE_MODEL=doubao-seedance-2-5-260628
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_CNY_PER_USD=7.2
# HeyGen API (VEO, Sora, Runway, Kling, Seedance via single key).
# HeyGen API（一个密钥可用 VEO、Sora、Runway、Kling、Seedance）。
HEYGEN_API_KEY=
# HeyGen Avatar V also uses HEYGEN_API_KEY and an eligible digital-twin look.
# HeyGen Avatar V 同样使用 HEYGEN_API_KEY，并需要符合条件的数字分身形象。
# Direct LTX-2.5 Fast/Pro asynchronous video API.
# LTX-2.5 Fast/Pro 直连异步视频 API。
LTX_API_KEY=
# Runway Gen-4 (direct API, alternative to fal.ai routing).
# Runway Gen-4（直连 API，fal.ai 路由的替代方案）。
RUNWAY_API_KEY=
# Volcengine Jimeng (即梦 AI) video generation via official API (HMAC-SHA256 V4 signing).
# 火山引擎即梦 AI 视频生成，走官方 API（HMAC-SHA256 V4 签名）。
VOLC_ACCESSKEY=
# Secret Access Key paired with VOLC_ACCESSKEY. Get both at https://console.volcengine.com/iam/keymanage
# 与 VOLC_ACCESSKEY 配对的 Secret Access Key。两者都在 https://console.volcengine.com/iam/keymanage 获取
VOLC_SECRETKEY=
# Set to "true" for local video gen (needs GPU + diffusers).
# 设为 "true" 启用本地视频生成（需要 GPU + diffusers）。
VIDEO_GEN_LOCAL_ENABLED=
# Local model: wan2.2-ti2v-5b, wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b.
# 本地模型：wan2.2-ti2v-5b、wan2.1-1.3b、wan2.1-14b、hunyuan-1.5、ltx2-local、cogvideo-5b。
VIDEO_GEN_LOCAL_MODEL=
# Modal self-hosted LTX-2 endpoint (optional).
# Modal 自托管 LTX-2 端点（可选）。
MODAL_LTX2_ENDPOINT_URL=

# ComfyUI server overrides (optional; default shared server is localhost:8188).
# Partner Nodes still require network access, a logged-in Comfy account, and credits.
# ComfyUI 服务器覆盖项（可选；默认共享服务器为 localhost:8188）。
# Partner Nodes 仍需网络访问、已登录的 Comfy 账号和点数。
COMFYUI_SERVER_URL=
COMFYUI_VIDEO_SERVER_URL=

# --- Stock Media ---
# Pexels stock footage/images (free).
# 素材库：Pexels 库存视频/图像（免费）。
PEXELS_API_KEY=
# Pixabay stock footage/images (free).
# Pixabay 库存视频/图像（免费）。
PIXABAY_API_KEY=
# Unsplash stock images (free developer key).
# Unsplash 库存图像（免费开发者密钥）。
UNSPLASH_ACCESS_KEY=

# --- Analysis ---
# HuggingFace token — enables speaker diarization in transcriber.
# 分析：HuggingFace token —— 启用 transcriber 的说话人分离。
HF_TOKEN=
# Speech: optional Azure AI Speech. One key/region unlocks both directions —
# azure_stt (Fast Transcription cloud STT) and azure_tts (neural cloud TTS).
# The local faster-whisper transcriber / piper_tts remain the default offline paths.
# 语音：可选 Azure AI Speech。一个 key/region 同时解锁两个方向 ——
# azure_stt（Fast Transcription 云端 STT）与 azure_tts（神经网络云端 TTS）。
# 本地 faster-whisper 转写 / piper_tts 仍是默认离线路径。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=     # Optional: full custom STT endpoint URL (overrides region)
# AZURE_TTS_ENDPOINT=        # Optional: full custom TTS host (e.g. https://<region>.tts.speech.microsoft.com)
# 可选：自定义 STT 完整端点 URL（覆盖 region）
# 可选：自定义 TTS 完整主机（例如 https://<region>.tts.speech.microsoft.com）

# --- Avatar (local installs) ---
# 数字人（本地安装）
# WAV2LIP_PATH=              # Path to cloned Wav2Lip repo (for lip sync)
# SADTALKER_PATH=            # Path to cloned SadTalker repo (for talking head avatars)
# 已克隆的 Wav2Lip 仓库路径（用于对口型）
# 已克隆的 SadTalker 仓库路径（用于说话头数字人）

# --- September 2026 model refresh ---
# Direct Ideogram 4.5 generation/editing, Precise Edit and dry-run price quotes.
# 2026 年 9 月模型刷新：Ideogram 4.5 直连生成/编辑、Precise Edit 及 dry-run 价格试算。
IDEOGRAM_API_KEY=
# Cartesia Sonic 3.6 speech (API version 2026-08-14).
# Cartesia Sonic 3.6 语音（API 版本 2026-08-14）。
CARTESIA_API_KEY=
# Inworld TTS-2 / Flash: paste the Base64 credential issued by the portal.
# The adapter adds Basic auth; do not Base64-encode it a second time.
# Inworld TTS-2 / Flash：粘贴门户签发的 Base64 凭据。
# 适配器会自动加 Basic auth；不要再做二次 Base64 编码。
INWORLD_API_KEY=
# Local Qwen Image 2.1 weights, already downloaded as a Diffusers model directory.
# 本地 Qwen Image 2.1 权重，已下载的 Diffusers 模型目录。
QWEN_IMAGE_21_PATH=
# GPT Image 2.5 reuses OPENAI_API_KEY; Gemini Pro image / 3.8 TTS / Lyria 3.5
# reuse Google credentials. Aggregator adapters reuse FAL_KEY,
# ATLASCLOUD_API_KEY and REPLICATE_API_TOKEN; no model-specific keys are needed.
# GPT Image 2.5 复用 OPENAI_API_KEY；Gemini Pro 图像 / 3.8 TTS / Lyria 3.5
# 复用 Google 凭据。聚合适配器复用 FAL_KEY、
# ATLASCLOUD_API_KEY 和 REPLICATE_API_TOKEN；无需模型专属密钥。

# --- October 23, 2026 provider refresh ---
# 2026 年 10 月 23 日 provider 刷新
BFL_API_KEY=
BRIA_API_TOKEN=
MISTRAL_API_KEY=
# Foundry resource origin, key, deployment name and declared model identity.
# Foundry 资源 origin、key、deployment 名称及声明的模型身份。
MAI_ENDPOINT=
MAI_API_KEY=
MAI_IMAGE_DEPLOYMENT=
MAI_IMAGE_MODEL=
MAI_TRANSCRIBE_DEPLOYMENT=
# MAI voice reuses AZURE_SPEECH_KEY / AZURE_SPEECH_REGION.
# HeyGen native/catalog voice reuse HEYGEN_API_KEY; Grok voice uses XAI_API_KEY.
# Eleven narration/soundtracks/realtime reuse ELEVENLABS_API_KEY.
# MAI 语音复用 AZURE_SPEECH_KEY / AZURE_SPEECH_REGION。
# HeyGen 原生/曲库音色复用 HEYGEN_API_KEY；Grok 音色使用 XAI_API_KEY。
# Eleven 旁白/配乐/实时语音复用 ELEVENLABS_API_KEY。
